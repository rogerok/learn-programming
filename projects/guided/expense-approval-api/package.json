{
  "name": "guided-expense-approval-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "eslint .",
    "start": "tsx src/index.ts",
    "test": "vitest run checks/baseline.test.ts",
    "test:baseline": "vitest run checks/baseline.test.ts",
    "check:1": "vitest run checks/milestone-1.test.ts",
    "check:2": "vitest run checks/milestone-1.test.ts checks/milestone-2.test.ts",
    "check:3": "vitest run checks/milestone-1.test.ts checks/milestone-2.test.ts checks/milestone-3.test.ts",
    "check:transfer": "vitest run checks/transfer.test.ts",
    "check": "vitest run checks/milestone-*.test.ts checks/transfer.test.ts"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-beta.101",
    "effect": "4.0.0-beta.101"
  },
  "devDependencies": {
    "@eslint/js": "9.32.0",
    "@types/node": "24.3.0",
    "eslint": "9.32.0",
    "globals": "16.3.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.39.0",
    "vitest": "3.2.4"
  }
}

{
  "name": "guided-seat-reservation-engine",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "eslint .",
    "smoke": "tsx src/index.ts",
    "test": "vitest run checks/starter.test.ts",
    "check": "vitest run checks/milestone-*.test.ts checks/transfer.test.ts",
    "check:1": "vitest run checks/milestone-1.test.ts",
    "check:2": "vitest run checks/milestone-1.test.ts checks/milestone-2.test.ts",
    "check:3": "vitest run checks/milestone-1.test.ts checks/milestone-2.test.ts checks/milestone-3.test.ts",
    "check:4": "vitest run checks/milestone-1.test.ts checks/milestone-2.test.ts checks/milestone-3.test.ts checks/milestone-4.test.ts",
    "check:5": "vitest run checks/milestone-1.test.ts checks/milestone-2.test.ts checks/milestone-3.test.ts checks/milestone-4.test.ts checks/milestone-5.test.ts",
    "check:6": "vitest run checks/milestone-*.test.ts",
    "check:transfer": "vitest run checks/transfer.test.ts",
    "check:ops": "vitest run checks/iteration-2-stream.test.ts checks/iteration-2-batching.test.ts checks/iteration-2-resilience.test.ts checks/iteration-2-adapters.test.ts",
    "check:ops:1": "vitest run checks/iteration-2-stream.test.ts",
    "check:ops:2": "vitest run checks/iteration-2-stream.test.ts checks/iteration-2-batching.test.ts",
    "check:ops:3": "vitest run checks/iteration-2-stream.test.ts checks/iteration-2-batching.test.ts checks/iteration-2-resilience.test.ts",
    "check:ops:4": "vitest run checks/iteration-2-stream.test.ts checks/iteration-2-batching.test.ts checks/iteration-2-resilience.test.ts checks/iteration-2-adapters.test.ts",
    "check:ops:transfer": "vitest run checks/iteration-2-transfer.test.ts"
  },
  "dependencies": {
    "@effect/cli": "0.76.0",
    "@effect/platform": "0.97.0",
    "@effect/platform-node": "0.108.0",
    "effect": "3.22.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-perfectionist": "^5.10.0"
  },
  "devDependencies": {
    "@effect/vitest": "0.30.0",
    "@eslint/js": "9.32.0",
    "@types/node": "24.3.0",
    "eslint": "9.32.0",
    "globals": "16.3.0",
    "prettier": "3.9.6",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.39.0",
    "vitest": "3.2.4"
  }
}

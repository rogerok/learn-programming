{
  "name": "guided-parcel-status-radar",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "eslint .",
    "start": "tsx src/main.ts",
    "smoke": "tsx src/main.ts scan PKG-101 PKG-102 PKG-101",
    "test": "vitest run checks/baseline.test.ts",
    "test:baseline": "vitest run checks/baseline.test.ts",
    "check:1": "vitest run checks/baseline.test.ts checks/milestone-1.test.ts",
    "check:2": "vitest run checks/baseline.test.ts checks/milestone-1.test.ts checks/milestone-2.test.ts",
    "check:3": "vitest run checks/baseline.test.ts checks/milestone-1.test.ts checks/milestone-2.test.ts checks/milestone-3.test.ts",
    "check:4": "vitest run checks/baseline.test.ts checks/milestone-1.test.ts checks/milestone-2.test.ts checks/milestone-3.test.ts checks/milestone-4.test.ts",
    "check:transfer": "vitest run checks/transfer.test.ts",
    "check": "vitest run checks/*.test.ts"
  },
  "dependencies": {
    "@effect/cli": "0.76.0",
    "@effect/platform": "0.97.0",
    "@effect/platform-node": "0.108.0",
    "effect": "3.22.0"
  },
  "devDependencies": {
    "@effect/vitest": "0.30.0",
    "@eslint/js": "9.32.0",
    "@types/node": "24.3.0",
    "eslint": "9.32.0",
    "globals": "16.3.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.39.0",
    "vitest": "3.2.4"
  }
}
